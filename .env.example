# Backend only. Copy to .env at the repository root and replace all placeholders.
# No value below is a working credential.
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_YOUR_LOCAL_DATABASE_PASSWORD
DB_NAME=smarttask_dev

# REQUIRED: generate a unique random value with at least 64 characters.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS
JWT_EXPIRES_IN=1h

# Used only by npm run seed:admin. Password must contain at least 12 characters.
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
