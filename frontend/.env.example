# Default browser requests use /api. Vite's DEV server proxies this to localhost:5000.
VITE_API_BASE_URL=/api

# Production requires a working same-origin /api reverse proxy, or a backend URL
# with an explicitly configured CORS policy. The dev proxy is not part of dist/.
# VITE_API_BASE_URL=https://YOUR_BACKEND_HOST/api
# Never put database passwords, JWT secrets or admin passwords in VITE_* variables.
